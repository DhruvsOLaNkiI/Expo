# ─── OpenRouter (recommended — free models at openrouter.ai/openrouter/free) ───
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here
# Auto-routes free models (Llama, Gemma, DeepSeek, etc.):
OPENROUTER_MODEL=openrouter/free
# Or pick one free model from openrouter.ai/openrouter/free/api:
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional: lock Ask AI to one deck — facts only (overrides CMS Scene → AI deck context).
# VITE_AI_DECK_CONTEXT=Project: Vertex Elite. Location: ...\nConfigurations: 4–6 BHK.

# Optional: max output tokens per chat reply (128–8192).
# VITE_GEMINI_MAX_OUTPUT_TOKENS=2048

# ─── Google Gemini (optional fallback if you still have quota) ───
# VITE_GEMINI_API_KEY=your_api_key_here
# VITE_GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Cloudflare R2 (PDFs + images from CMS / PageIndex — dev server only unless you deploy the upload API)
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com   (account root only — no /bucket suffix)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=virtual-expo-pdfs
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev                    (r2.dev origin only — no /bucket suffix)
# Object keys are booths/<boothId>/<folder>/<file> — never virtual-expo-pdfs/booths/...

# MongoDB Atlas (visitor registration + PageIndex trees — server-side only)
# MONGODB_URI=mongodb+srv://...
